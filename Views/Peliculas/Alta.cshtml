@using informacion
@model PeliculaCreateViewModel

<h2>Crear Pelicula</h2>
<form asp-action="Create" method="post" class="mt-4">
    <div class="mb-3">
        <label asp-for="Titulo" class="form-label">Titulo de la pelicula</label>
        <input asp-for="Titulo" class="form-control" />
        <span asp-validation-for="Titulo" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Anio" class="form-label">Anio</label>
        <!-- step="0.01" permite ingresar decimales si el precio es float -->
        <input asp-for="Anio" type="number" step="0.01" class="form-control" />
        <span asp-validation-for="Precio" class="text-danger"></span>
    </div>
    <div>
        <label asp-for="categoria"></label>
        <select asp-for="categoria" asp-items="Html.GetEnumSelectList<Categoria>()">
            <option value="">-- Seleccionar --</option>
        </select>
        <span asp-validation-for="categoria"></span>
    </div>

    <button type="submit" class="btn btn-success">Guardar Pelicula</button>
    <a asp-action="Index" class="btn btn-secondary">Cancelar y volver</a>
</form>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}