@using informacion
@model PeliculaUpdateViewModel

<h2>Editar Producto</h2>
<form asp-action="Edit" method="post">
    <!-- Este input oculto es CLAVE para que el POST sepa qué ID está editando -->
    <input type="hidden" asp-for="Id" />
    
    <div class="mb-3">
        <label asp-for="Titulo" class="form-label">Titulo de la Pelicula</label>
        <input asp-for="Titulo" class="form-control" />
        <span asp-validation-for="Titulo" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Anio" class="form-label">Anio</label>
        <!-- step="0.01" permite ingresar decimales si el precio es float -->
        <input asp-for="Anio" type="number" step="0.01" class="form-control" />
        <span asp-validation-for="Anio" class="text-danger"></span>
    </div>
    <div>
        <label asp-for="categoria"></label>
        <select asp-for="categoria" asp-items="Html.GetEnumSelectList<Categoria>()">
            <option value="">-- Seleccionar --</option>
        </select>
        <span asp-validation-for="categoria"></span>
    </div>

    <!-- Resto de tus campos y el botón de submit -->
    <button type="submit" class="btn btn-primary">Guardar Cambios</button>
    <a asp-action="Index" class="btn btn-secondary ms-2">Cancelar</a>
</form>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}