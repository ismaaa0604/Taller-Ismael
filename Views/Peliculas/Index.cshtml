@using informacion;
@model List<Peliculas>
<p>
    <a asp-action="Create" class="btn btn-primary">Crear Producto</a>
</p>
@if (Model.Count == 0){
    <p>No hay peliculas</p>
}
else
{
    <table>
        <thead>
            <tr>
                <th>Titulo</th>
                <th>Anio</th>
                <th>Categoria</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var pelicula in Model)
            {
                <tr>
                    <td>@pelicula.Titulo</td>
                    <td>@pelicula.Anio</td>
                    <td>@pelicula.Categoria</td>
                    <td>
                        <a asp-action="Edit" asp-route-id="@producto.idProducto">Modificar</a>
                    </td>
                    <td>
                        <a asp-action="Delete" asp-route-id="@producto.idProducto">Eliminar</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}